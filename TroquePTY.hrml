<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Generador de Placas del Mundial - Horizontal</title>
    <style>
        :root {
            --bg-color: #121212;
            --panel-bg: #1e1e1e;
            --gold: #d4af37;
            --gold-light: #f3e5ab;
            --text-color: #ffffff;
            --border-color: #333;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: var(--bg-color);
            color: var(--text-color);
            margin: 0;
            padding: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            min-height: 100vh;
        }

        h1 {
            color: var(--gold);
            text-align: center;
            margin-bottom: 5px;
            font-size: 1.8rem;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        p.subtitle {
            color: #888;
            margin-bottom: 25px;
            font-size: 0.9rem;
        }

        .container {
            width: 100%;
            max-width: 900px;
            background: var(--panel-bg);
            padding: 20px;
            border-radius: 12px;
            box-shadow: 0 8px 24px rgba(0,0,0,0.5);
            border: 1px solid var(--border-color);
        }

        .form-group {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        input[type="text"] {
            flex: 1;
            padding: 12px 16px;
            background: #2a2a2a;
            border: 1px solid #444;
            border-radius: 6px;
            color: #fff;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.3s;
        }

        input[type="text"]:focus {
            border-color: var(--gold);
        }

        button {
            padding: 12px 24px;
            background: linear-gradient(135deg, #d4af37, #aa820a);
            color: #000;
            font-weight: bold;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            transition: opacity 0.3s, transform 0.1s;
            font-size: 1rem;
            text-transform: uppercase;
        }

        button:hover {
            opacity: 0.9;
        }

        button:active {
            transform: scale(0.98);
        }

        .plates-container {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-top: 20px;
        }

        /* Estilo de la Placa Troquelada Horizontal */
        .plate {
            position: relative;
            background: linear-gradient(145deg, #2c251e, #1a1612);
            border: 3px solid var(--gold);
            border-radius: 16px;
            padding: 15px 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            box-shadow: inset 0 0 15px rgba(0,0,0,0.8), 0 6px 12px rgba(0,0,0,0.4);
            overflow: hidden;
            min-height: 90px;
        }

        /* Detalles de los bordes troquelados estilo insignia */
        .plate::before {
            content: '';
            position: absolute;
            top: 4px; left: 4px; right: 4px; bottom: 4px;
            border: 1px dashed rgba(212, 175, 55, 0.4);
            border-radius: 12px;
            pointer-events: none;
        }

        .plate-left, .plate-right {
            display: flex;
            align-items: center;
            gap: 15px;
            z-index: 2;
        }

        .trophy-icon {
            font-size: 2.2rem;
            filter: drop-shadow(0 2px 4px rgba(0,0,0,0.5));
        }

        .plate-title {
            display: flex;
            flex-direction: column;
        }

        .plate-title span:first-child {
            font-size: 0.75rem;
            color: var(--gold-light);
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .plate-title span:last-child {
            font-size: 1.3rem;
            font-weight: bold;
            color: #fff;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        .plate-center {
            text-align: center;
            z-index: 2;
        }

        .match-score {
            background: rgba(0, 0, 0, 0.6);
            border: 1px solid var(--gold);
            padding: 6px 18px;
            border-radius: 20px;
            font-size: 1.2rem;
            font-weight: bold;
            color: var(--gold-light);
            letter-spacing: 2px;
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.5);
        }

        .instagram-tag {
            font-size: 0.85rem;
            color: var(--gold);
            background: rgba(212, 175, 55, 0.1);
            padding: 4px 10px;
            border-radius: 4px;
            border: 1px solid rgba(212, 175, 55, 0.3);
            z-index: 2;
        }

        @media (max-width: 768px) {
            .plate {
                flex-direction: column;
                gap: 10px;
                text-align: center;
                padding: 20px;
            }
            .plate-left, .plate-right {
                flex-direction: column;
                gap: 5px;
            }
        }
    </style>
</head>
<body>

    <h1>Generador de Placas Horizontales</h1>
    <p class="subtitle">Estilo Troquelado Oficial del Mundial</p>

    <div class="container">
        <div class="form-group">
            <input type="text" id="igUser" placeholder="Ingresa tu usuario de Instagram (ej. @steven_dior)" value="@steven_dior">
            <button onclick="generarPlacas()">Generar Placas</button>
        </div>

        <div class="plates-container" id="platesContainer">
            <!-- Las placas se inyectarán dinámicamente aquí -->
        </div>
    </div>

    <script>
        function generarPlacas() {
            const user = document.getElementById('igUser').value.trim() || '@usuario';
            const container = document.getElementById('platesContainer');
            
            // Datos simulados de partidos del estilo de las placas anteriores
            const matches = [
                { fase: "FINAL", equipo1: "España", equipo1Icon: "🇪🇸", score: "1 - 0", equipo2: "Argentina", equipo2Icon: "🇦🇷" },
                { fase: "TERCER PUESTO", equipo1: "Francia", equipo1Icon: "🇫🇷", score: "4 - 6", equipo2: "Inglaterra", equipo2Icon: "🏴󠁧󠁢󠁥󠁮󠁧󠁿" }
            ];

            container.innerHTML = '';

            matches.forEach(match => {
                const plateHtml = `
                    <div class="plate">
                        <div class="plate-left">
                            <span class="trophy-icon">🏆</span>
                            <div class="plate-title">
                                <span>${match.fase}</span>
                                <span>${match.equipo1Icon} ${match.equipo1}</span>
                            </div>
                        </div>
                        
                        <div class="plate-center">
                            <div class="match-score">${match.score}</div>
                        </div>

                        <div class="plate-right">
                            <div class="plate-title" style="text-align: right;">
                                <span>Rival</span>
                                <span>${match.equipo2} ${match.equipo2Icon}</span>
                            </div>
                            <div class="instagram-tag">${user}</div>
                        </div>
                    </div>
                `;
                container.innerHTML += plateHtml;
            });
        }

        // Generar al cargar por defecto
        window.onload = generarPlacas;
    </script>
</body>
</html>
