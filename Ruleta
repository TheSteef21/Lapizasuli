<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SADV41 | Ruleta de Tómbola</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        body { 
            background-color: #050a14; 
            background-image: radial-gradient(circle at 50% 50%, #0b132b 0%, #02040a 100%);
            color: #ffffff; 
            font-family: system-ui, -apple-system, sans-serif; 
            min-height: 100vh;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }
        
        /* Efectos de Luz */
        .cyan-glow { text-shadow: 0 0 15px #06b6d4, 0 0 30px #06b6d4; }
        .gold-glow { box-shadow: 0 0 15px #eab308, inset 0 0 10px #eab308; }

        /* Paneles de Cristal */
        .glass-panel { 
            background: rgba(16, 25, 43, 0.6); 
            backdrop-filter: blur(8px); 
            border: 1px solid rgba(59, 130, 246, 0.3); 
            border-radius: 1rem;
            padding: 2rem;
            text-align: center;
        }

        /* Contenedor de la Ruleta */
        .wheel-container {
            position: relative;
            width: 350px;
            height: 350px;
            margin: 2rem auto;
        }

        /* El Canvas de la Ruleta */
        #wheel {
            width: 100%;
            height: 100%;
            border-radius: 50%;
            border: 4px solid #1e293b;
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.4);
            transition: transform 4s cubic-bezier(0.17, 0.67, 0.12, 0.99); /* Efecto de giro suave */
        }

        /* El Puntero (Flecha) */
        .pointer {
            position: absolute;
            top: -15px;
            left: 50%;
            transform: translateX(-50%);
            width: 0; 
            height: 0; 
            border-left: 15px solid transparent;
            border-right: 15px solid transparent;
            border-top: 30px solid #eab308; /* Flecha Dorada */
            z-index: 10;
            filter: drop-shadow(0 0 5px #eab308);
        }

        /* Animación del Premio */
        @keyframes pop {
            0% { transform: scale(0.8); opacity: 0; }
            50% { transform: scale(1.1); opacity: 1; }
            100% { transform: scale(1); opacity: 1; }
        }
        .winner-pop {
            animation: pop 0.5s ease-out forwards;
        }
    </style>
</head>
<body>

    <header class="text-center z-10 mb-4">
        <h1 class="text-3xl md:text-5xl font-bold cyan-glow mb-2 uppercase tracking-widest">SADV41 Tómbola</h1>
        <p class="text-gray-300">Premio: <span class="text-yellow-400 font-bold">Cupón B/. 2.50</span> - Reparación/Instalación</p>
    </header>

    <main class="glass-panel z-10">
        
        <div class="wheel-container">
            <div class="pointer"></div>
            <canvas id="wheel" width="400" height="400"></canvas>
        </div>

        <button id="spin-btn" class="mt-4 px-8 py-3 bg-blue-600 hover:bg-blue-500 text-white font-bold rounded-full transition-all border border-blue-400 shadow-[0_0_15px_rgba(59,130,246,0.6)] uppercase tracking-wide">
            Tirar Ruleta
        </button>

        <div id="result-box" class="mt-6 hidden">
            <p class="text-sm text-gray-400 uppercase">Ganador del Cupón:</p>
            <h2 id="winner-name" class="text-4xl font-bold text-yellow-400 mt-1 uppercase"></h2>
        </div>

    </main>

    <footer class="mt-8 text-xs text-gray-500 z-10">
        Operador: StevenDiorOficial | Transmisión Federal Activa
    </footer>

    <script>
        const canvas = document.getElementById("wheel");
        const ctx = canvas.getContext("2d");
        const spinBtn = document.getElementById("spin-btn");
        const resultBox = document.getElementById("result-box");
        const winnerName = document.getElementById("winner-name");

        // Los 10 espacios de la ruleta (puedes cambiar los nombres aquí)
        const sectors = [
            { color: "#0ea5e9", label: "Taxi 1" },
            { color: "#3b82f6", label: "Taxi 2" },
            { color: "#6366f1", label: "Taxi 3" },
            { color: "#8b5cf6", label: "Taxi 4" },
            { color: "#d946ef", label: "Taxi 5" },
            { color: "#ec4899", label: "Taxi 6" },
            { color: "#f43f5e", label: "Taxi 7" },
            { color: "#eab308", label: "Taxi 8" },
            { color: "#22c55e", label: "Taxi 9" },
            { color: "#14b8a6", label: "Taxi 10" }
        ];

        const tot = sectors.length;
        const arc = (2 * Math.PI) / tot;
        let rotation = 0; // Rotación actual en grados

        // Función para dibujar la ruleta en el Canvas
        function drawWheel() {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            for (let i = 0; i < tot; i++) {
                const angle = i * arc;
                
                // Dibujar sector (rebanada)
                ctx.beginPath();
                ctx.fillStyle = sectors[i].color;
                ctx.moveTo(200, 200);
                ctx.arc(200, 200, 200, angle, angle + arc);
                ctx.lineTo(200, 200);
                ctx.fill();
                ctx.stroke();

                // Dibujar texto
                ctx.save();
                ctx.translate(200, 200);
                ctx.rotate(angle + arc / 2);
                ctx.textAlign = "right";
                ctx.fillStyle = "#ffffff";
                ctx.font = "bold 22px system-ui";
                // Sombra para el texto para que resalte
                ctx.shadowColor = "rgba(0,0,0,0.5)";
                ctx.shadowBlur = 4;
                ctx.fillText(sectors[i].label, 180, 8);
                ctx.restore();
            }
        }

        drawWheel();

        // Lógica de Giro
        spinBtn.addEventListener("click", () => {
            // Ocultar resultado anterior
            resultBox.classList.add("hidden");
            resultBox.classList.remove("winner-pop");
            spinBtn.disabled = true;
            spinBtn.classList.add("opacity-50", "cursor-not-allowed");

            // Calcular giro aleatorio (entre 5 y 10 vueltas completas + un extra aleatorio)
            const extraSpins = Math.floor(Math.random() * 5) + 5; 
            const randomDegree = Math.floor(Math.random() * 360);
            rotation += (extraSpins * 360) + randomDegree;

            // Aplicar la rotación al canvas mediante CSS
            canvas.style.transform = `rotate(${rotation}deg)`;

            // Esperar a que termine la animación CSS (4 segundos)
            setTimeout(() => {
                // Calcular el ganador
                // Nota: El puntero está en la parte superior (270 grados en el canvas)
                const actualRotation = rotation % 360;
                // Ajuste porque el canvas gira en sentido horario y el puntero está arriba
                const pointerAngle = (360 - actualRotation + 270) % 360; 
                const sectorIndex = Math.floor(pointerAngle / (360 / tot));
                
                const winner = sectors[sectorIndex].label;

                // Mostrar el ganador
                winnerName.textContent = winner;
                resultBox.classList.remove("hidden");
                resultBox.classList.add("winner-pop");

                // Reactivar botón
                spinBtn.disabled = false;
                spinBtn.classList.remove("opacity-50", "cursor-not-allowed");
            }, 4000); // 4000ms = 4 segundos (debe coincidir con la transición CSS)
        });
    </script>
</body>
</html>
